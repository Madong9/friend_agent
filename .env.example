APP_ENV=development
DATA_BACKEND=sqlite
DATABASE_URL=sqlite:///./campus_social.db
# CloudBase shared-PG staging（不使用 PostgreSQL host/port）：
# DATA_BACKEND=cloudbase_http
# CLOUDBASE_ENV_ID=
# CLOUDBASE_API_KEY=
# CLOUDBASE_PG_API_URL=  # 可省略，默认由环境 ID 生成
# CLOUDBASE_HTTP_TIMEOUT_SECONDS=15
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT_SECONDS=30
# auto 会按 Base URL/模型识别 DeepSeek 和 GLM 的 json_object 协议
LLM_RESPONSE_FORMAT=auto
LLM_FALLBACK_TO_MOCK=true
# 默认不继承宿主 HTTP_PROXY/ALL_PROXY；确实需要代理时设 true，并使用 http:// 或 socks5:// URL
OUTBOUND_HTTP_TRUST_ENV=false
DEBUG_AGENT_TRACE=true
AGENT_SESSION_TTL_MINUTES=1440
AGENT_TRACE_TTL_DAYS=7
AGENT_TRACE_MAX_ENTRIES=1000
AGENT_TURN_LOCK_SECONDS=120
JWT_SECRET=change-this-development-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=120
JWT_ISSUER=campus-social-agent
REQUIRE_CAMPUS_VERIFICATION=false

# WeChat mini program identity
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# Local development auth (never enable in production)
DEV_AUTH_MODE=false
DEV_USER_ID=user001

# Mock user visibility
SHOW_MOCK_USERS=true
ALLOW_MOCK_VERIFICATION=true
