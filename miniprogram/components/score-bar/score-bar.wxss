/* components/score-bar */
.score-bar {
  width: 100%;
}
.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label {
  width: 120rpx;
  font-size: 24rpx;
  color: #5c6370;
}
.track {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.fill {
  height: 100%;
  background: #1aad19;
  border-radius: 6rpx;
}
.value {
  width: 90rpx;
  text-align: right;
  font-size: 24rpx;
  color: #1f2329;
}
