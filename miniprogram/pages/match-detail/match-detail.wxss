/* pages/match-detail/match-detail.wxss */
.head .name {
  display: flex;
  align-items: center;
}
.nickname {
  font-size: 40rpx;
  font-weight: 700;
}
.meta {
  margin-top: 12rpx;
  color: #5c6370;
  font-size: 26rpx;
}
.bio {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.score-line {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5c6370;
}
.total {
  color: #1aad19;
  font-size: 40rpx;
  font-weight: 700;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.reason-item {
  font-size: 26rpx;
  color: #1f2329;
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.icebreaker {
  background: #eef7ee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2329;
}
.feedback-help,
.mock-help {
  margin-bottom: 16rpx;
  color: #5c6370;
  font-size: 24rpx;
  line-height: 1.5;
}
.mock-help {
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #fff7e6;
  color: #ad6800;
}
.feedback-card .btn-like {
  background: #1aad19;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.secondary-actions {
  display: flex;
  margin-top: 16rpx;
}
.secondary-actions button {
  flex: 1;
  margin: 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  color: #5c6370;
  font-size: 26rpx;
}
.secondary-actions .btn-not-relevant {
  margin-left: 16rpx;
  color: #8a919f;
}
.danger .btn-block {
  background: #fff1f0;
  color: #d4380d;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.danger .btn-report {
  background: #fff7e6;
  color: #d46b08;
  font-size: 28rpx;
  border-radius: 12rpx;
}
