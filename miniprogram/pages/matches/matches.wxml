<!-- pages/matches/matches.wxml -->
<view class="matches">
  <view class="page-heading">
    <view class="page-title">我的匹配</view>
    <view class="page-subtitle">处理推荐，双方感兴趣后即可建立联系</view>
  </view>

  <view class="section-panel mutual-section">
    <view class="section-head">
      <view>
        <view class="section-title">互相感兴趣</view>
        <view class="section-caption">已经达成双向选择的伙伴</view>
      </view>
      <view wx:if="{{mutualMatches.length > 0}}" class="count-badge">{{mutualMatches.length}}</view>
    </view>
    <block wx:if="{{mutualMatches.length > 0}}">
      <view class="mutual-card" wx:for="{{mutualMatches}}" wx:key="match_id" bindtap="goMatched" data-partner="{{item.partner.id}}">
        <view class="mutual-row">
          <text class="mutual-icon">🎉</text>
          <view class="mutual-info">
            <view>
              <text class="mutual-name">{{item.partner.nickname}}</text>
              <text wx:if="{{item.partner.is_mock}}" class="mock-badge">测试匹配</text>
            </view>
            <text class="mutual-meta">{{item.partner.campus}} · {{item.partner.grade}} · {{item.partner.major}}</text>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
    </block>
    <view wx:else class="compact-empty">
      <text class="empty-icon">🤝</text>
      <view class="empty-copy">
        <view class="empty-title">还没有互相匹配</view>
        <view class="empty-desc">点击“感兴趣”，对方回应后会出现在这里</view>
      </view>
    </view>
  </view>

  <view class="section-panel queue-section">
    <view class="section-head">
      <view>
        <view class="section-title">推荐待处理</view>
        <view class="section-caption">选择后将从当前列表移除</view>
      </view>
      <view wx:if="{{queue.length > 0}}" class="count-badge">{{queue.length}}</view>
    </view>
    <block wx:if="{{queue.length > 0}}">
      <view class="queue-item" wx:for="{{queue}}" wx:key="id">
        <match-card
          candidate="{{item}}"
          my-interests="{{myInterests}}"
          feedback-disabled="{{loading}}"
          bind:detail="goCandidateDetail"
          bind:like="onLike"
          bind:pass="onPass"
          bind:notrelevant="onNotRelevant"
        />
      </view>
    </block>
    <view wx:else class="compact-empty">
      <text class="empty-icon">🔎</text>
      <view class="empty-copy">
        <view class="empty-title">暂无待处理推荐</view>
        <view class="empty-desc">去“找搭子”描述你想找的伙伴</view>
      </view>
    </view>
  </view>
</view>
