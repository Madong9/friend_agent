/* pages/profile/profile.wxss */
.section-title {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}
.input {
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.textarea {
  width: auto;
  height: 140rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.actions {
  padding: 0 50rpx;
}
.btn-secondary {
  margin-top: 24rpx;
  background: #ffffff;
  color: #1aad19;
  border: 2rpx solid #1aad19;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}
.privacy-note { color: #777; line-height: 1.6; margin-bottom: 14rpx; }
.consent { display: block; margin: 16rpx 0; font-size: 26rpx; }
.personality-summary { background: #f2f8ff; border-radius: 10rpx; padding: 16rpx; margin: 14rpx 0; }
.load-error { color: #b42318; line-height: 1.6; }
.notification-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #dcefe0;
}
.notification-entry-active { background: #f4fbf5; }
.notification-copy { min-width: 0; }
.notification-title { font-size: 30rpx; font-weight: 600; color: #17221a; }
.notification-subtitle { margin-top: 8rpx; color: #777; font-size: 25rpx; }
.notification-action { display: flex; align-items: center; margin-left: 20rpx; }
.notification-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 20rpx;
  background: #e5484d;
  color: #fff;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: center;
}
.notification-arrow { margin-left: 14rpx; color: #999; font-size: 46rpx; }
